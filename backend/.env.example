# Servidor
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000

# Base de datos PostgreSQL
DATABASE_URL="postgresql://venvios:venvios@localhost:5432/venvios?schema=public"

# Sesión (mínimo 32 caracteres). Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-este-secreto-por-uno-de-64-caracteres-en-produccion
JWT_EXPIRES_IN=7d

# Twilio WhatsApp. Si se omiten, las notificaciones quedan en modo simulación.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# Almacenamiento local de fotos
UPLOAD_DIR=uploads

# Datos del administrador inicial (npm run db:seed)
ADMIN_EMAIL=admin@venviosexpress.com
ADMIN_PASSWORD=VenviosAdmin2026!
ADMIN_NOMBRE=Operaciones Venvios
ADMIN_TELEFONO=+573237968740
