generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  CLIENTE
  OPERADOR
  ADMIN
}

enum Modalidad {
  M1
  M2
}

enum Transportista {
  MRW
  ZOOM
}

enum TipoEnvio {
  ALERTA
  CONSOLIDADO
}

enum EstadoEnvio {
  PREALERTADO
  RECIBIDO_PARCIAL
  RECIBIDO_COMPLETO
  ARCHIVADO
  POR_CONSOLIDAR
  POR_PAGAR
  POR_CONFIRMAR
  PAGADO
  DESPACHADO
  CERRADO
  CANCELADO
}

enum EstadoPaquete {
  ESPERADO
  RECIBIDO
}

enum MetodoPago {
  BINANCE
  PAGO_MOVIL
  TRANSFERENCIA
  MANUAL
}

enum MonedaPago {
  USD
  BS
}

enum EstadoPago {
  POR_CONFIRMAR
  CONFIRMADO
  RECHAZADO
}

enum FuenteTasa {
  API
  MANUAL
}

model Usuario {
  id               String   @id @default(cuid())
  nombre           String
  cedulaCifrada    String
  cedulaHuella     String   @unique
  email            String   @unique
  codigo           String   @unique
  telefono         String   @unique
  passwordHash     String
  rol              Rol      @default(CLIENTE)
  activo           Boolean  @default(true)
  debeCambiarClave Boolean  @default(false)
  sesionVersion    Int      @default(0)
  creadoEn         DateTime @default(now())

  envios Envio[]

  @@index([rol])
}

model Envio {
  id                     String        @id @default(cuid())
  tipo                   TipoEnvio     @default(ALERTA)
  clienteId              String
  modalidad              Modalidad
  transportista          Transportista
  tienda                 String
  valorDeclaradoCentavos Int
  estado                 EstadoEnvio   @default(PREALERTADO)
  pesoTotalCentesimas    Int?
  pesoCobrableCentesimas Int?
  fleteCentavos          Int?
  seguroCentavos         Int?
  totalCentavos          Int?
  entregaNombreCifrado   String?
  entregaCedulaCifrada   String?
  entregaTelefonoCifrado String?
  entregaAgencia         String?
  entregaCiudad          String?
  entregaEstado          String?
  guiaVenezolana         String?
  guiaFotoPath           String?
  creadoEn               DateTime      @default(now())
  actualizadoEn          DateTime      @updatedAt

  cliente  Usuario   @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  paquetes Paquete[]
  pagos    Pago[]
  eventos  Evento[]

  @@index([clienteId, estado])
  @@index([estado])
  @@index([creadoEn])
}

model Paquete {
  id                   String        @id @default(cuid())
  envioId              String
  trackingTexto        String
  trackingNormalizado  String        @unique
  estado               EstadoPaquete @default(ESPERADO)
  pesoCentesimas       Int?
  fotoPath             String?
  avisadoEn            DateTime?
  avisadoPorId         String?
  recibidoPorId        String?
  recibidoEn           DateTime?

  envio Envio @relation(fields: [envioId], references: [id], onDelete: Cascade)

  @@index([envioId])
  @@index([fotoPath])
}

model Pago {
  id                    String      @id @default(cuid())
  envioId               String
  montoUsdCentavos      Int
  moneda                MonedaPago
  montoOriginalCentavos Int
  metodo                MetodoPago
  referencia            String?
  referenciaRepetida    Boolean     @default(false)
  comprobantePath       String?
  estado                EstadoPago  @default(POR_CONFIRMAR)
  motivoRechazo         String?
  tasaBcv               Float?
  registradoPorId       String
  confirmadoPorId       String?
  creadoEn              DateTime    @default(now())

  envio Envio @relation(fields: [envioId], references: [id], onDelete: Cascade)

  @@index([envioId, estado])
  @@index([referencia])
}

model Evento {
  id       String   @id @default(cuid())
  envioId  String
  actorId  String?
  tipo     String
  detalle  String
  datos    Json?
  creadoEn DateTime @default(now())

  envio Envio @relation(fields: [envioId], references: [id], onDelete: Cascade)

  @@index([envioId, creadoEn])
}

model Configuracion {
  clave String @id
  valor Json
}

model TasaBcv {
  fecha            String     @id
  bolivaresPorUsd  Float
  fuente           FuenteTasa
  creadoEn         DateTime   @default(now())
}

model IntentoAcceso {
  clave  String   @id
  cuenta Int
  hasta  DateTime
}
